{
  "name": "noted-terminal",
  "version": "1.0.0",
  "description": "macOS workspace for persistent Claude Code and Codex sessions, history and agent collaboration",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "NOTED_WEB_PORT=7979 electron-vite dev",
    "dev:d": "cd design-lab && npm run dev",
    "build": "npm run build:app",
    "build:install": "node scripts/build-install-noted-terminal.mjs",
    "sign:local-fast": "bash scripts/codesign/sign-local-fast.sh \"release/mac-arm64/Noted Terminal.app\" com.noted.terminal",
    "build:mobile": "cd mobile-web && npm run build && echo '[build:mobile] mobile-web/dist rebuilt'",
    "build:m": "npm run build:mobile",
    "install:terminal-mcp": "node scripts/install-terminal-mcp.mjs",
    "install:claude-hook": "node scripts/install-claude-turn-hook.mjs",
    "backfill:orchestration-tags": "ELECTRON_RUN_AS_NODE=1 electron scripts/backfill-orchestration-tags.mjs",
    "build:i": "npm run build:install",
    "build:i-obs": "node scripts/build-when-idle.js",
    "build:i-cont": "node scripts/build-and-continue.js",
    "_rebuild": "node scripts/node-pty-build.mjs",
    "_test:e2e": "cd runtime-tests && npx playwright test",
    "_test:e2e:headed": "cd runtime-tests && npx playwright test --headed",
    "build:renderer": "npm run build:markdown && electron-vite build",
    "build:app": "node scripts/build-public-app.mjs",
    "rebuild:native": "node scripts/setup-native.mjs",
    "build:markdown": "npm run build --workspace @gt-editor/markdown-editor",
    "test:setup": "node --test scripts/public-setup.test.mjs scripts/node-pty-build.test.mjs scripts/install-terminal-mcp.test.mjs scripts/install-claude-turn-hook.test.mjs scripts/runtime-api-key.test.mjs"
  },
  "build": {
    "appId": "com.noted.terminal",
    "productName": "Noted Terminal",
    "beforePack": "./scripts/node-pty-build.mjs",
    "afterExtract": "./scripts/node-pty-build.mjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build-resources/icon.icns",
      "target": "dir",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "build-resources/icon.png",
      "build-resources/icon-dev.png",
      "mobile-web/dist/**/*",
      "package.json",
      "!logs/**"
    ],
    "extraResources": [
      {
        "from": "vendor/noted-shared/packages/file-explorer/main",
        "to": "shared-packages/file-explorer"
      }
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-arm64/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-x64/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/node_modules/@anthropic-ai/**",
      "node_modules/@koromix/koffi-*/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.156",
    "@assistant-ui/react": "^0.12.24",
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@babel/parser": "7.29.3",
    "@google/genai": "^1.38.0",
    "@gt-editor/markdown-editor": "file:vendor/markdown-editor",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.6.2",
    "debug": "^4.4.3",
    "framer-motion": "^12.27.5",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "koffi": "^3.1.2",
    "lucide-react": "^0.562.0",
    "node-pty": "^1.2.0-beta.13",
    "react": "^19.2.3",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "virtua": "^0.48.6",
    "ws": "^8.20.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-source": "^7.27.1",
    "@electron/rebuild": "^4.0.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/debug": "^4.1.12",
    "@vitejs/plugin-react": "^5.1.2",
    "code-inspector-plugin": "^1.5.1",
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RevinFedor/custom-terminal.git"
  },
  "workspaces": [
    "vendor/markdown-editor"
  ]
}
