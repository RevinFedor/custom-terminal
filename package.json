{
  "name": "noted-terminal",
  "version": "1.0.0",
  "description": "Terminal with tabs and notes",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "NOTED_WEB_PORT=7979 electron-vite dev",
    "dev:d": "cd design-lab && npm run dev",
    "build": "NODE_GYP_FORCE_PYTHON=/Users/fedor/.node-gyp-py/bin/python CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && NODE_GYP_FORCE_PYTHON=/Users/fedor/.node-gyp-py/bin/python CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder && npm run sign:local-fast",
    "build:install": "bash scripts/graceful-quit.sh 20 && npm run build:markdown && npm run build:mobile && NODE_GYP_FORCE_PYTHON=/Users/fedor/.node-gyp-py/bin/python CSC_IDENTITY_AUTO_DISCOVERY=false electron-vite build && NODE_GYP_FORCE_PYTHON=/Users/fedor/.node-gyp-py/bin/python CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder && npm run sign:local-fast && npm run install:terminal-mcp && npm run install:claude-hook && npm run install:codex-sidechannel && rm -rf /Applications/Noted\\ Terminal.app && cp -R release/mac-arm64/Noted\\ Terminal.app /Applications/ && open /Applications/Noted\\ Terminal.app",
    "sign:local-fast": "bash scripts/codesign/sign-local-fast.sh \"release/mac-arm64/Noted Terminal.app\" com.noted.terminal",
    "build:mobile": "cd mobile-web && npm run build && echo '[build:mobile] mobile-web/dist rebuilt'",
    "build:m": "npm run build:mobile",
    "install:terminal-mcp": "node scripts/install-terminal-mcp.mjs",
    "install:claude-hook": "node scripts/install-claude-turn-hook.mjs",
    "install:codex-sidechannel": "bash scripts/build-install-noted-codex.sh",
    "backfill:orchestration-tags": "ELECTRON_RUN_AS_NODE=1 electron scripts/backfill-orchestration-tags.mjs",
    "build:i": "npm run build:install",
    "build:i-obs": "node scripts/build-when-idle.js",
    "build:i-cont": "node scripts/build-and-continue.js",
    "build:markdown": "cd ../gt-editor/packages/markdown-editor && npm run build && rsync -a --delete dist/ ../../../custom-terminal/node_modules/@gt-editor/markdown-editor/dist/ && rm -rf ../../../custom-terminal/node_modules/.vite && echo '[build:markdown] gt-editor → custom-terminal node_modules synced, vite cache cleared'",
    "_rebuild": "NODE_GYP_FORCE_PYTHON=/Users/fedor/.node-gyp-py/bin/python electron-rebuild -f -w node-pty",
    "_test:e2e": "cd runtime-tests && npx playwright test",
    "_test:e2e:headed": "cd runtime-tests && npx playwright test --headed"
  },
  "build": {
    "appId": "com.noted.terminal",
    "productName": "Noted Terminal",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build-resources/icon.icns",
      "target": "dir",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "build-resources/icon.png",
      "build-resources/icon-dev.png",
      "mobile-web/dist/**/*",
      "package.json",
      "!logs/**"
    ],
    "extraResources": [
      {
        "from": "../noted-shared/packages/file-explorer/main",
        "to": "shared-packages/file-explorer"
      }
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-arm64/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-darwin-x64/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/node_modules/@anthropic-ai/**",
      "node_modules/@koromix/koffi-*/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.156",
    "@assistant-ui/react": "^0.12.24",
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@google/genai": "^1.38.0",
    "@gt-editor/markdown-editor": "^0.1.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.6.2",
    "debug": "^4.4.3",
    "framer-motion": "^12.27.5",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "koffi": "^3.1.2",
    "lucide-react": "^0.562.0",
    "node-pty": "^1.2.0-beta.13",
    "react": "^19.2.3",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "virtua": "^0.48.6",
    "ws": "^8.20.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-source": "^7.27.1",
    "@electron/rebuild": "^4.0.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/debug": "^4.1.12",
    "@vitejs/plugin-react": "^5.1.2",
    "code-inspector-plugin": "^1.5.1",
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  }
}
